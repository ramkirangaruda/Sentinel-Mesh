.venv/
__pycache__/
*.pyc
scratch_audit/

# raw external inputs — large, not meant for git
benign/pip_downloads/
benign/pip_downloads_win_amd64/
benign/pip_downloads_win32/
benign/npm_downloads/
benign/extracted/
benign/*.log
benign/pkg_list.txt
build_all.log
retrain_fileguard.log
service.log
data/security/
data/traces/*.jsonl

# trained model artifacts can be large; keep small ones (mailguard) but not big ones by default
models/*.bin

# field-model test pipeline: deterministic, regenerate with
# `make test-field-model` -- only the scripts are committed
tests/synthetic_traces/
tests/synthetic_field_model.h
tests/synthetic_field_model_metrics.json
tests/parity_features.csv
tests/field_model_harness.exe
tests/field_model_harness.out
tests/*.o

# the real field model is only meaningful once real traces exist
export/field_model.h
reports/field_model_metrics.json

# energygate test pipeline (v4): same deal, regenerate with
# `make test-energygate` -- only the scripts are committed
tests/synthetic_energygate.h
tests/synthetic_energygate_metrics.json
tests/energygate_parity_features.csv
tests/energygate_harness.exe
tests/energygate_harness.out

# the real EnergyGate model is only meaningful once real traces exist
export/energygate.h
# the simulated stopgap's working copy; the committed one is the firmware's energygate_model.h
export/energygate_synthetic.h
reports/energygate_metrics.json
